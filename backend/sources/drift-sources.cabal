cabal-version:      3.0
name:               drift-sources
version:            0.1.0.0
synopsis:           Source search for Driftwords: Wikipedia, OpenAlex, CSL-JSON, relevance
build-type:         Simple

-- A separate package on purpose: M6 starts without touching drift.cabal or the
-- test entry point, which M1, M2 and M7 are editing. Module names follow the
-- layout in TECH_ROADMAP.md section 6, so folding them into the main package
-- later is a file move.

common shared
  default-language: GHC2021
  default-extensions:
    DerivingStrategies
    LambdaCase
    OverloadedStrings
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wredundant-constraints

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:
    Drift.Pipeline.Sources
    Drift.Search.Http
    Drift.Search.OpenAlex
    Drift.Search.Text
    Drift.Search.Types
    Drift.Search.Wikipedia
    Drift.Sources.Csl
    Drift.Sources.Doi
    Drift.Sources.Relevance
  build-depends:
    , aeson               >=2.2  && <2.4
    , async               >=2.2  && <2.3
    , base                >=4.20 && <5
    , bytestring          >=0.10 && <0.13
    , case-insensitive    >=1.2  && <1.3
    , containers          >=0.6  && <0.8
    , drift
    , http-client         >=0.7  && <0.8
    , http-client-tls     >=0.3  && <0.4
    , http-types          >=0.12 && <0.13
    , scientific          >=0.3  && <0.4
    , text                >=2.0  && <2.2
    , unicode-transforms  >=0.4  && <0.5
    , vector              >=0.12 && <0.14

executable drift-sources
  import:           shared
  hs-source-dirs:   app
  main-is:          Main.hs
  ghc-options:      -threaded -rtsopts
  build-depends:
    , aeson
    , base
    , bytestring
    , drift
    , drift-sources
    , text

test-suite sources-test
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:
    CslSpec
    LiveSpec
    OpenAlexSpec
    PipelineSpec
    RelevanceSpec
    TextSpec
    WikipediaSpec
  ghc-options:      -threaded
  build-depends:
    , aeson
    , base
    , bytestring
    , containers
    , drift
    , drift-sources
    , hspec          >=2.11 && <2.12
    , text
