cabal-version:      3.0
name:               drift
version:            0.1.0.0
synopsis:           Backend for Driftwords, a thinking workbench
build-type:         Simple

common shared
  default-language: GHC2021
  default-extensions:
    DerivingStrategies
    LambdaCase
    OverloadedStrings
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wredundant-constraints

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:
    Drift.Api
    Drift.Model.Config
    Drift.Model.Mock
    Drift.Model.OpenAICompat
    Drift.Model.Provider
    Drift.Model.Scheduler
    Drift.Pipeline.Branches
    Drift.Pipeline.Prefetch
    Drift.Protocol
    Drift.Protocol.Options
  build-depends:
    , aeson             >=2.2  && <2.4
    , aeson-typescript  >=0.6  && <0.7
    , async             >=2.2  && <2.3
    , base              >=4.20 && <5
    , bytestring        >=0.10 && <0.13
    , containers        >=0.6  && <0.8
    , http-client       >=0.7  && <0.8
    , http-client-tls   >=0.3  && <0.4
    , http-types        >=0.12 && <0.13
    , optparse-applicative >=0.18 && <0.20
    , scientific        >=0.3  && <0.4
    , servant-server    >=0.20 && <0.21
    , stm               >=2.5  && <2.6
    , text              >=2.0  && <2.2
    , unicode-transforms >=0.4 && <0.5
    , yaml              >=0.11 && <0.12

executable drift-server
  import:           shared
  hs-source-dirs:   app
  main-is:          Server.hs
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , base
    , drift
    , servant-server
    , warp           >=3.4 && <3.5

executable drift-gen-ts
  import:           shared
  hs-source-dirs:   app
  main-is:          GenTs.hs
  build-depends:
    , aeson-typescript
    , base
    , drift

executable drift-branches
  import:           shared
  hs-source-dirs:   app
  main-is:          Branches.hs
  ghc-options:      -threaded
  build-depends:
    , base
    , containers
    , drift
    , optparse-applicative
    , text

test-suite drift-test
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:
    BranchesSpec
    ModelProviderSpec
    PrefetchSpec
    ProtocolSpec
    SchedulerSpec
  ghc-options:      -threaded
  build-depends:
    , aeson
    , base
    , bytestring
    , containers
    , directory
    , drift
    , filepath
    , hspec       >=2.11 && <2.12
    , QuickCheck  >=2.14 && <2.17
    , stm
    , text
