cabal-version:      3.0
name:               drift
version:            0.1.0.0
synopsis:           Backend for Driftwords, a thinking workbench
build-type:         Simple

common shared
  default-language: GHC2021
  default-extensions:
    DerivingStrategies
    LambdaCase
    OverloadedStrings
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wredundant-constraints

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:
    Drift.Api
    Drift.Domain.Decide
    Drift.Domain.State
    Drift.Domain.Types
    Drift.Domain.Word
    Drift.Model.SessionMock
    Drift.Protocol
    Drift.Protocol.Options
    Drift.Server.SessionActor
    Drift.Server.WebSocket
    Drift.Store.SQLite
  build-depends:
    , aeson             >=2.2  && <2.4
    , aeson-typescript  >=0.6  && <0.7
    , async
    , base              >=4.20 && <5
    , bytestring
    , containers
    , servant-server    >=0.20 && <0.21
    , sqlite-simple
    , stm
    , text              >=2.0  && <2.2
    , time
    , transformers
    , unicode-transforms
    , wai
    , wai-websockets
    , warp              >=3.4  && <3.5
    , websockets

executable drift-server
  import:           shared
  hs-source-dirs:   app
  main-is:          Server.hs
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , base
    , drift
    , servant-server
    , warp           >=3.4 && <3.5
    , wai-websockets
    , websockets

executable drift-gen-ts
  import:           shared
  hs-source-dirs:   app
  main-is:          GenTs.hs
  build-depends:
    , aeson-typescript
    , base
    , drift

test-suite drift-test
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:
    DomainDecideSpec
    DomainPropertySpec
    DomainReplaySpec
    ProtocolSpec
    ServerSpec
    SessionActorSpec
    SessionE2ESpec
    StoreSpec
  ghc-options:      -threaded
  build-depends:
    , aeson
    , async
    , base
    , bytestring
    , containers
    , directory
    , drift
    , filepath
    , hspec       >=2.11 && <2.12
    , http-client
    , http-types
    , network
    , process
    , QuickCheck  >=2.14 && <2.17
    , servant-server
    , sqlite-simple
    , stm
    , text
    , wai-websockets
    , warp           >=3.4 && <3.5
    , websockets
